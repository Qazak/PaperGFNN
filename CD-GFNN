        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "import numpy as np\n",
        "\n",
        "from sklearn.datasets import load_breast_cancer\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.neural_network import MLPClassifier\n",
        "\n",
        "from sklearn.metrics import (\n",
        "    accuracy_score,\n",
        "    precision_score,\n",
        "    recall_score,\n",
        "    f1_score,\n",
        "    roc_auc_score\n",
        ")\n",
        "\n",
        "# ==========================================================\n",
        "# SYNAPTIC DIVERGENCE\n",
        "# ==========================================================\n",
        "\n",
        "def compute_synaptic_divergence(model, X):\n",
        "\n",
        "    z = np.dot(X, model.coefs_[0]) + model.intercepts_[0]\n",
        "\n",
        "    h = np.tanh(z)\n",
        "\n",
        "    h_mean = np.mean(h, axis=0)\n",
        "\n",
        "    return np.mean(\n",
        "        np.abs(h - h_mean),\n",
        "        axis=0\n",
        "    )\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# SD-GFNN\n",
        "# ==========================================================\n",
        "\n",
        "class SDGFNN:\n",
        "\n",
        "    def __init__(\n",
        "        self,\n",
        "        tau=0.80,\n",
        "        epsilon=0.008,\n",
        "        min_improvement=0.001,\n",
        "        initial_neurons=8,\n",
        "        max_growth_rounds=10,\n",
        "        random_state=0\n",
        "    ):\n",
        "\n",
        "        self.tau = tau\n",
        "        self.epsilon = epsilon\n",
        "        self.min_improvement = min_improvement\n",
        "\n",
        "        self.initial_neurons = initial_neurons\n",
        "        self.max_growth_rounds = max_growth_rounds\n",
        "        self.random_state = random_state\n",
        "\n",
        "        self.best_model = None\n",
        "        self.best_val_acc = -np.inf\n",
        "\n",
        "        self.best_neurons = None\n",
        "        self.terminal_neurons = None\n",
        "        self.growth_events = 0\n",
        "\n",
        "    # ======================================================\n",
        "    # TRAINING\n",
        "    # ======================================================\n",
        "\n",
        "    def fit(\n",
        "        self,\n",
        "        X_train,\n",
        "        y_train,\n",
        "        X_val,\n",
        "        y_val\n",
        "    ):\n",
        "\n",
        "        neurons = self.initial_neurons\n",
        "\n",
        "        threshold = (\n",
        "            self.tau +\n",
        "            self.epsilon\n",
        "        )\n",
        "\n",
        "        prev_acc = None\n",
        "\n",
        "        fib1 = 1\n",
        "        fib2 = 1\n",
        "\n",
        "        for r in range(\n",
        "            self.max_growth_rounds\n",
        "        ):\n",
        "\n",
        "            model = MLPClassifier(\n",
        "                hidden_layer_sizes=(neurons,),\n",
        "                activation=\"tanh\",\n",
        "                solver=\"adam\",\n",
        "                max_iter=1000,\n",
        "                random_state=self.random_state\n",
        "            )\n",
        "\n",
        "            model.fit(\n",
        "                X_train,\n",
        "                y_train\n",
        "            )\n",
        "\n",
        "            val_pred = model.predict(\n",
        "                X_val\n",
        "            )\n",
        "\n",
        "            val_acc = accuracy_score(\n",
        "                y_val,\n",
        "                val_pred\n",
        "            )\n",
        "\n",
        "            d_max = np.max(\n",
        "                compute_synaptic_divergence(\n",
        "                    model,\n",
        "                    X_val\n",
        "                )\n",
        "            )\n",
        "\n",
        "            acc_gain = (\n",
        "                np.inf\n",
        "                if prev_acc is None\n",
        "                else val_acc - prev_acc\n",
        "            )\n",
        "\n",
        "            prev_acc = val_acc\n",
        "\n",
        "            # ----------------------------------\n",
        "            # SAVE BEST MODEL\n",
        "            # ----------------------------------\n",
        "\n",
        "            if val_acc > self.best_val_acc:\n",
        "\n",
        "                self.best_val_acc = val_acc\n",
        "                self.best_model = model\n",
        "                self.best_neurons = neurons\n",
        "\n",
        "            print(\n",
        "                f\"R={r+1:02d} | \"\n",
        "                f\"N={neurons:3d} | \"\n",
        "                f\"Acc={val_acc:.4f} | \"\n",
        "                f\"D={d_max:.4f} | \"\n",
        "                f\"Gain={acc_gain:.5f}\"\n",
        "            )\n",
        "\n",
        "            # ----------------------------------\n",
        "            # STOPPING CONDITIONS\n",
        "            # ----------------------------------\n",
        "\n",
        "            if d_max <= threshold:\n",
        "\n",
        "                self.terminal_neurons = neurons\n",
        "\n",
        "                print(\n",
        "                    f\"Stop: \"\n",
        "                    f\"D={d_max:.4f} \"\n",
        "                    f\"<= \"\n",
        "                    f\"{threshold:.4f}\"\n",
        "                )\n",
        "\n",
        "                break\n",
        "\n",
        "            if (\n",
        "                r > 0 and\n",
        "                acc_gain <= self.min_improvement\n",
        "            ):\n",
        "\n",
        "                self.terminal_neurons = neurons\n",
        "\n",
        "                print(\n",
        "                    f\"Stop: \"\n",
        "                    f\"Gain={acc_gain:.6f}\"\n",
        "                )\n",
        "\n",
        "                break\n",
        "\n",
        "            # ----------------------------------\n",
        "            # FIBONACCI GROWTH\n",
        "            # ----------------------------------\n",
        "\n",
        "            self.growth_events += 1\n",
        "\n",
        "            if r < 2:\n",
        "\n",
        "                neurons += 1\n",
        "\n",
        "            else:\n",
        "\n",
        "                growth = fib1 + fib2\n",
        "\n",
        "                fib1, fib2 = (\n",
        "                    fib2,\n",
        "                    growth\n",
        "                )\n",
        "\n",
        "                neurons += growth\n",
        "\n",
        "        if self.terminal_neurons is None:\n",
        "\n",
        "            self.terminal_neurons = neurons\n",
        "\n",
        "    # ======================================================\n",
        "    # PREDICTION\n",
        "    # ======================================================\n",
        "\n",
        "    def predict(self, X):\n",
        "\n",
        "        return self.best_model.predict(X)\n",
        "\n",
        "    def predict_proba(self, X):\n",
        "\n",
        "        return self.best_model.predict_proba(X)\n",
        "\n",
        "\n",
        "# ==========================================================\n",
        "# DATA\n",
        "# ==========================================================\n",
        "\n",
        "data = load_breast_cancer()\n",
        "\n",
        "X = data.data\n",
        "y = data.target\n",
        "\n",
        "# ==========================================================\n",
        "# EXPERIMENTS\n",
        "# ==========================================================\n",
        "\n",
        "N_RUNS = 30\n",
        "\n",
        "acc_list = []\n",
        "prec_list = []\n",
        "rec_list = []\n",
        "f1_list = []\n",
        "auc_list = []\n",
        "\n",
        "growth_list = []\n",
        "best_neuron_list = []\n",
        "terminal_neuron_list = []\n",
        "\n",
        "for seed in range(N_RUNS):\n",
        "\n",
        "    X_train_full, X_test, y_train_full, y_test = (\n",
        "        train_test_split(\n",
        "            X,\n",
        "            y,\n",
        "            test_size=0.20,\n",
        "            stratify=y,\n",
        "            random_state=seed\n",
        "        )\n",
        "    )\n",
        "\n",
        "    X_train, X_val, y_train, y_val = (\n",
        "        train_test_split(\n",
        "            X_train_full,\n",
        "            y_train_full,\n",
        "            test_size=0.20,\n",
        "            stratify=y_train_full,\n",
        "            random_state=seed\n",
        "        )\n",
        "    )\n",
        "\n",
        "    scaler = StandardScaler()\n",
        "\n",
        "    X_train = scaler.fit_transform(\n",
        "        X_train\n",
        "    )\n",
        "\n",
        "    X_val = scaler.transform(\n",
        "        X_val\n",
        "    )\n",
        "\n",
        "    X_test = scaler.transform(\n",
        "        X_test\n",
        "    )\n",
        "\n",
        "    model = SDGFNN(\n",
        "        tau=0.80,\n",
        "        epsilon=0.008,\n",
        "        min_improvement=0.001,\n",
        "        initial_neurons=8,\n",
        "        max_growth_rounds=10,\n",
        "        random_state=seed\n",
        "    )\n",
        "\n",
        "    model.fit(\n",
        "        X_train,\n",
        "        y_train,\n",
        "        X_val,\n",
        "        y_val\n",
        "    )\n",
        "\n",
        "    pred = model.predict(\n",
        "        X_test\n",
        "    )\n",
        "\n",
        "    prob = model.predict_proba(\n",
        "        X_test\n",
        "    )[:, 1]\n",
        "\n",
        "    acc_list.append(\n",
        "        accuracy_score(\n",
        "            y_test,\n",
        "            pred\n",
        "        )\n",
        "    )\n",
        "\n",
        "    prec_list.append(\n",
        "        precision_score(\n",
        "            y_test,\n",
        "            pred,\n",
        "            average=\"weighted\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    rec_list.append(\n",
        "        recall_score(\n",
        "            y_test,\n",
        "            pred,\n",
        "            average=\"weighted\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    f1_list.append(\n",
        "        f1_score(\n",
        "            y_test,\n",
        "            pred,\n",
        "            average=\"weighted\"\n",
        "        )\n",
        "    )\n",
        "\n",
        "    auc_list.append(\n",
        "        roc_auc_score(\n",
        "            y_test,\n",
        "            prob\n",
        "        )\n",
        "    )\n",
        "\n",
        "    growth_list.append(\n",
        "        model.growth_events\n",
        "    )\n",
        "\n",
        "    best_neuron_list.append(\n",
        "        model.best_neurons\n",
        "    )\n",
        "\n",
        "    terminal_neuron_list.append(\n",
        "        model.terminal_neurons\n",
        "    )\n",
        "\n",
        "# ==========================================================\n",
        "# RESULTS\n",
        "# ==========================================================\n",
        "\n",
        "print(\"\\n\" + \"=\" * 70)\n",
        "print(\"SD-GFNN RESULTS\")\n",
        "print(\"=\" * 70)\n",
        "\n",
        "print(\n",
        "    f\"Accuracy Mean            : \"\n",
        "    f\"{np.mean(acc_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Accuracy Std             : \"\n",
        "    f\"{np.std(acc_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Precision Mean           : \"\n",
        "    f\"{np.mean(prec_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Recall Mean              : \"\n",
        "    f\"{np.mean(rec_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"F1 Mean                  : \"\n",
        "    f\"{np.mean(f1_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"F1 Std                   : \"\n",
        "    f\"{np.std(f1_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"ROC-AUC Mean             : \"\n",
        "    f\"{np.mean(auc_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"ROC-AUC Std              : \"\n",
        "    f\"{np.std(auc_list):.4f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Average Growth Events    : \"\n",
        "    f\"{np.mean(growth_list):.2f}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Average Best Neurons     : \"\n",
        "    f\"{np.mean(best_neuron_list):.2f}\"\n",
